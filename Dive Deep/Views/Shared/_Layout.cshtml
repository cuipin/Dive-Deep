<!DOCTYPE html>
<html lang="da">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]Dive Deep</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Dive_Deep.styles.css" asp-append-version="true" />
    <style>

            html, body {
                height: 100%;
                margin: 0;
                padding: 0;
            }

            body {
                display: flex;
                flex-direction: column;
                min-height: 100vh;
                background-color: ivory;
                color: #333;
                margin: 0;
            }

            .container {
                flex: 1;
            }

            /* Navbar Styling */
            .navbar {
                background: linear-gradient(90deg,rgba(57, 113, 143, 1) 0%, rgba(79, 202, 227, 1) 66%, rgba(5, 104, 235, 1) 100%);
                box-shadow: 0 4px 15px rgba(0, 0, 0, 0.1);
                padding: 12px 30px;
                border-radius: 15px;
                margin: 15px 20px;
                border: 1px solid rgba(0, 0, 0, 0.05);
            }

            .navbar-brand {
                display: flex;
                align-items: center;
                gap: 10px;
                font-size: 20px;
                font-weight: 700;
                color: #4a7ba7;
                text-decoration: none;
                transition: all 0.3s ease;
            }

                .navbar-brand:hover {
                    color: #3a5f82;
                    transform: translateY(-2px);
                }

                .navbar-brand img {
                    height: 45px;
                    width: auto;
                    border-radius: 5px;
                }

            .navbar-brand-text {
                color: #000000;
                font-weight: 700;
                font-size: 18px;
            }

            /* Navigation Links */
            .navbar-nav {
                gap: 30px;
            }

            .nav-link {
                color: #333 !important;
                font-weight: 500;
                font-size: 15px;
                position: relative;
                transition: all 0.3s ease;
                padding: 8px 0;
            }

                .nav-link:hover {
                    color: #4a7ba7 !important;
                }

                .nav-link::after {
                    content: '';
                    position: absolute;
                    bottom: 0;
                    left: 0;
                    width: 0;
                    height: 2px;
                    background-color: #4a7ba7;
                    transition: width 0.3s ease;
                }

                .nav-link:hover::after {
                    width: 100%;
                }

                .nav-link.active {
                    color: #4a7ba7 !important;
                }

                    .nav-link.active::after {
                        width: 100%;
                    }

            /* Search Bar */
            .search-container {
                flex: 0 0 250px;
                margin: 0 20px;
            }

            .search-input {
                width: 100%;
                padding: 10px 15px;
                border: 1px solid #ddd;
                border-radius: 25px;
                font-size: 13px;
                background-color: #f5f5f5;
                transition: all 0.3s ease;
                color: #333;
            }

                .search-input::placeholder {
                    color: #999;
                }

                .search-input:focus {
                    outline: none;
                    background-color: #fff;
                    border-color: #4a7ba7;
                    box-shadow: 0 0 8px rgba(74, 123, 167, 0.2);
                }

            /* Icon Buttons */
            .icon-btn {
                background: none;
                border: none;
                color: #333;
                font-size: 20px;
                cursor: pointer;
                transition: all 0.3s ease;
                padding: 8px 12px;
                position: relative;
                display: flex;
                align-items: center;
                justify-content: center;
            }

                .icon-btn:hover {
                    color: #4a7ba7;
                    transform: scale(1.1);
                }

                .icon-btn.active {
                    color: #d32f2f;
                }

            /* Badge for Cart */
            .badge-cart {
                position: absolute;
                top: 0;
                right: 0;
                background-color: #d32f2f;
                color: white;
                border-radius: 50%;
                width: 20px;
                height: 20px;
                display: flex;
                align-items: center;
                justify-content: center;
                font-size: 10px;
                font-weight: 700;
            }

            /* Login Button */
            .btn-login {
                background: linear-gradient(135deg, #4a7ba7 0%, #3a5f82 100%);
                color: white;
                border: none;
                padding: 10px 25px;
                border-radius: 25px;
                font-weight: 600;
                font-size: 14px;
                cursor: pointer;
                transition: all 0.3s ease;
                display: flex;
                align-items: center;
                gap: 8px;
                text-decoration: none;
            }

                .btn-login:hover {
                    background: linear-gradient(135deg, #3a5f82 0%, #2a4566 100%);
                    transform: translateY(-2px);
                    box-shadow: 0 4px 12px rgba(74, 123, 167, 0.3);
                    color: white;
                }

                .btn-login:active {
                    transform: translateY(0);
                }

            /* Right side container */
            .navbar-right {
                display: flex;
                align-items: center;
                gap: 20px;
                margin-left: auto;
            }

            /* Mobile responsiveness */
            @@media (max-width: 1024px) {
                .navbar {
                    padding: 10px 15px;
                }

                .search-container {
                    flex: 0 0 200px;
                    margin: 0 10px;
                }

                .navbar-nav {
                    gap: 15px;
                }

                .nav-link {
                    font-size: 14px;
                }
            }

            @@media (max-width: 768px) {
                .navbar {
                    padding: 10px;
                    margin: 10px 10px;
                }

                .search-container {
                    display: none;
                }

                .navbar-brand-text {
                    display: none;
                }

                .navbar-collapse {
                    margin-top: 15px;
                }

                .navbar-nav {
                    flex-direction: column;
                    gap: 10px;
                }

                .nav-link {
                    padding: 10px 0;
                }
            }

            /* Footer - Sticky Footer */
            footer {
                flex-shrink: 0;
                width: 100%;
                background: linear-gradient(90deg,rgba(57, 113, 143, 1) 0%, rgba(79, 202, 227, 1) 40%, rgba(5, 104, 235, 1) 100%);
                color: rgb(0, 0, 0);
                padding: 20px 0;
                text-align: center;
                font-size: 12px;
                box-shadow: 0 -1px 5px rgba(0,0,0,0.1);
                margin-top: 20px;
            }
    </style>
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg">
            <div class="container-fluid">
                <!-- Logo and Brand -->
                <a class="navbar-brand" asp-controller="Home" asp-action="Index">
                    <img src="https://i.ibb.co/xSh0WRf4/Dive-Deep-Logo.png" alt="Dive Deep Logo">
                    <span class="navbar-brand-text">Dive Deep</span>
                </a>

                <!-- Navbar Toggler for Mobile -->
                <button class="navbar-toggler" type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#mainNavbar"
                        aria-controls="mainNavbar"
                        aria-expanded="false"
                        aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <!-- Collapsible Navigation -->
                <div class="collapse navbar-collapse" id="mainNavbar">
                    <!-- Navigation Links -->
                    <ul class="navbar-nav mx-auto">
                        <li class="nav-item">
                            <a class="nav-link active" asp-controller="Home" asp-action="Index">Hjem</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Products" asp-action="Index">Produkter</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Home" asp-action="Privacy">Om os</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Contact" asp-action="Index">Kontakt</a>
                        </li>
                    </ul>

                    <!-- Search Bar -->
                    <div class="search-container">
                        <input type="search" class="search-input" placeholder="Søg efter udstyr...">
                    </div>

                    <!-- Right side icons and login -->
                    <div class="navbar-right">
                        <!-- Wishlist Icon -->
                        <button class="icon-btn" id="wishlistBtn" title="Ønskeseddel">
                            <span>♥</span>
                        </button>

                        <!-- Cart ikon med tal -->
                        <a class="icon-btn" asp-controller="Cart" asp-action="Index" title="Indkøbskurv">
                            <span style="position: relative;">
                                🛒
                                <span class="badge-cart">0</span>
                            </span>
                        </a>

                        <!-- Login Button -->
                        <a class="btn-login" asp-controller="Login" asp-action="Index">
                            <span>👤</span>
                            <span>Log ind</span>
                        </a>
                    </div>
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div>
            Adresse: Dykkervej 10, 5000 Odense C
            CVR-nummer: 81828384
            Telefonnummer: +45 60708090 E-mail: info@divedeep.dk
            © 2025 Dive Deep

            Åbningstider
            Mandag-fredag: 10:00 - 17:30
            Lørdag: 10:00 - 14:00
            Søndag: Lukket
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script>
            // Navbar interactivity
            document.addEventListener('DOMContentLoaded', function() {
                // Active link highlighting based on current page
                const currentUrl = window.location.pathname;
                const navLinks = document.querySelectorAll('.navbar-nav .nav-link');

                navLinks.forEach(link => {
                    link.classList.remove('active');
                    if (link.getAttribute('href') === currentUrl ||
                        link.getAttribute('asp-action') !== undefined) {
                        // The active class will be set by asp-action comparison
                    }
                });

                // Wishlist button interactivity
                const wishlistBtn = document.getElementById('wishlistBtn');
                if (wishlistBtn) {
                    wishlistBtn.addEventListener('click', function(e) {
                        e.preventDefault();
                        this.classList.toggle('active');
                        // Add animation
                        this.style.animation = 'none';
                        setTimeout(() => {
                            this.style.animation = 'heart-beat 0.3s';
                        }, 10);
                    });
                }

                // Search input focus effect
                const searchInput = document.querySelector('.search-input');
                if (searchInput) {
                    searchInput.addEventListener('focus', function() {
                        this.parentElement.style.boxShadow = '0 0 8px rgba(74, 123, 167, 0.3)';
                    });

                    searchInput.addEventListener('blur', function() {
                        this.parentElement.style.boxShadow = 'none';
                    });

                    searchInput.addEventListener('keypress', function(e) {
                        if (e.key === 'Enter') {
                            // Handle search
                            console.log('Search for:', this.value);
                        }
                    });
                }

                // Navbar links hover effects
                const navItems = document.querySelectorAll('.navbar-nav .nav-link');
                navItems.forEach(item => {
                    item.addEventListener('mouseenter', function() {
                        this.style.transform = 'translateY(-2px)';
                    });

                    item.addEventListener('mouseleave', function() {
                        this.style.transform = 'translateY(0)';
                    });
                });
            });

            // Heart beat animation
            const style = document.createElement('style');
            style.textContent = `
                        @@keyframes heart-beat {
                            0%, 100% { transform: scale(1); }
                            50% { transform: scale(1.2); }
                        }
                    `;
            document.head.appendChild(style);
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>