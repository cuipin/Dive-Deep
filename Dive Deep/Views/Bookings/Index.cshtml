@model IReadOnlyList<Dive_Deep.Models.Booking>
@using System.Globalization
@using Dive_Deep.Models
@using Dive_Deep.Services
@{
    ViewData["Title"] = (bool)(ViewBag.IsAdmin ?? false) ? "Administrer bookinger" : "Mine bookinger";
    var isAdmin = (bool)(ViewBag.IsAdmin ?? false);
    var culture = CultureInfo.GetCultureInfo("da-DK");
}

<section class="booking-page-heading">
    <p class="eyebrow">@(isAdmin ? "ADMINISTRATION" : "DIN KONTO")</p>
    <h1>@(isAdmin ? "Alle kunders bookinger" : "Mine bookinger")</h1>
    <p>@(isAdmin
        ? "Se hver kundes booking, gennemgå alle udstyrslinjer, og rediger eller annullér bookinger."
        : "Her kan du se og redigere dine egne bookinger.")</p>
</section>

@if (TempData["BookingSuccess"] is string successMessage)
{
    <div class="notice notice-success" role="status">@successMessage</div>
}

@if (Model.Count == 0)
{
    <div class="empty-state">
        <h2>@(isAdmin ? "Der er ingen bookinger endnu" : "Du har ingen bookinger endnu")</h2>
        <p>@(isAdmin ? "Kundernes bekræftede bookinger vises her." : "Vælg udstyr, og bekræft lejen fra kurven.")</p>
        @if (!isAdmin)
        {
            <a class="button button-primary" asp-controller="Products" asp-action="Index">Se produkter</a>
        }
    </div>
}
else
{
    <div class="booking-list">
        @foreach (var booking in Model)
        {
            var statusLabel = booking.Status switch
            {
                BookingStatus.Confirmed => "Bekræftet",
                BookingStatus.Cancelled => "Annulleret",
                BookingStatus.Completed => "Afsluttet",
                _ => booking.Status.ToString()
            };

            <article class="booking-card">
                <header class="booking-card-header">
                    <div>
                        <p class="eyebrow">BOOKING #@booking.BookingId</p>
                        @if (isAdmin)
                        {
                            <h2>@booking.User?.FirstName @booking.User?.LastName</h2>
                            <p class="booking-customer">@booking.User?.Email · Brugernavn: @booking.User?.UserName</p>
                        }
                        else
                        {
                            <h2>Oprettet @DanishDateTime.ToLocal(booking.CreatedAtUtc).ToString("dd-MM-yyyy HH:mm")</h2>
                        }
                    </div>
                    <span class="booking-status status-@booking.Status.ToString().ToLowerInvariant()">@statusLabel</span>
                </header>

                <div class="booking-lines">
                    @foreach (var item in booking.Items.OrderBy(line => line.BookingItemId))
                    {
                        var start = item.StartTime;
                        var end = item.EndTime;
                        var rentalDays = Math.Max(1, (int)Math.Ceiling((end - start).TotalDays));
                        var lineTotal = item.DailyRateAtBooking * item.Quantity * rentalDays;

                        <section class="booking-line">
                            <div class="booking-product">
                                <p class="product-category-label">@item.ProductVariant.Product.Category.Name</p>
                                <h3>@item.ProductVariant.Product.Brand @item.ProductVariant.Product.Model</h3>
                                <p class="muted-text">@item.ProductVariant.OptionLabel · @item.Quantity stk.</p>
                            </div>
                            <div class="booking-period">
                                <span>Fra</span>
                                <strong>@start.ToString("dd-MM-yyyy HH:mm")</strong>
                                <span>Til</span>
                                <strong>@end.ToString("dd-MM-yyyy HH:mm")</strong>
                            </div>
                            <div class="booking-line-price">
                                <span>@rentalDays @(rentalDays == 1 ? "dag" : "dage") · @item.DailyRateAtBooking.ToString("C0", culture)/dag</span>
                                <strong>@lineTotal.ToString("C0", culture)</strong>
                            </div>
                            @if (booking.Status == BookingStatus.Confirmed)
                            {
                                <a class="button button-secondary booking-edit-button"
                                   asp-controller="Bookings"
                                   asp-action="Edit"
                                   asp-route-id="@booking.BookingId"
                                   asp-route-itemId="@item.BookingItemId">
                                    Rediger linje
                                </a>
                            }
                        </section>
                    }
                </div>

                <footer class="booking-card-footer" style="color:black">
                        <span>Booking oprettet @DanishDateTime.ToLocal(booking.CreatedAtUtc).ToString("dd-MM-yyyy HH:mm")</span>
                    @if (booking.Status == BookingStatus.Confirmed)
                    {
                        <form asp-controller="Bookings" asp-action="Delete" asp-route-id="@booking.BookingId" method="post">
                            <button type="submit" class="remove-link"
                                    onclick="return confirm('Vil du annullere booking #@booking.BookingId?');">
                                Annullér booking
                            </button>
                        </form>
                    }
                </footer>
            </article>
        }
    </div>
}

@if (!isAdmin)
{
    <a asp-controller="Bookings" asp-action="Add" class="button button-primary booking-create-button">Opret booking</a>
}
