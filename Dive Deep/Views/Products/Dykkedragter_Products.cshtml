@using Dive_Deep.Models;
@using Dive_Deep.Models.ProduktTypes;
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@model IEnumerable<Dykkerdragter>
@{
    ViewData["title"] = "Dykkerdragter Produkter";
}

<div class="row row-cols-1 row-cols-md-3 g-4">
    @foreach (var Dykkerdragter in Model)
    {
        <div class="col">
            <div class="card">
                <a href="default.asp"><img src="~/lib/Images/Dykkerdragt.webp" class="card-img-top" alt="..."></a>
                <div class="card-body">
                    <h5 class="card-title">Model: @Dykkerdragter.Model</h5>
                    <h5 class="card-title">Type: @Dykkerdragter.Type</h5>
                    <h5 class="card-title">Mærke: @Dykkerdragter.Mærke</h5>
                    <h5 class="card-title">Køn: @Dykkerdragter.Køn</h5>
                    <h5 class="card-title">Størrelse: @Dykkerdragter.Størrelse</h5>
                    <h5 class="card-title">Tykkelse i mm: @Dykkerdragter.Tykkelse</h5>
                    <h5 class="card-title">Pris pr dag i kr: @Dykkerdragter.PrisPrDag</h5>
                    <p class="card-text"></p>
                    <a href="#" class="btn btn-primary">Tilføj til Kurv</a>
                </div>
            </div>
        </div>
    }
</div>

