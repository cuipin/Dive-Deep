@using Dive_Deep.Models;
@using Dive_Deep.Models.ProduktTypes;
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@model IEnumerable<Regulatorsæt>
@{
    ViewData["title"] = "Regulatorsæt Produkter";
}

<div class="row row-cols-1 row-cols-md-3 g-4">
    @foreach (var Regulatorsæt in Model)
    {
        <div class="col">
            <div class="card">
                <a href="default.asp"><img src="~/lib/Images/Regulatorsæt.WEBP" class="card-img-top" alt="..."></a>
                <div class="card-body">
                    <h5 class="card-title">Mærke: @Regulatorsæt.Mærke</h5>
                    <h5 class="card-title">Trin1: @Regulatorsæt.Trin1</h5>
                    <h5 class="card-title">Trin2: @Regulatorsæt.Trin2</h5>
                    <h5 class="card-title">Octopus: @Regulatorsæt.Octopus</h5>
                    <h5 class="card-title">Pris pr dag i kr: @Regulatorsæt.PrisPrDag</h5>
                    <p class="card-text"></p>
                    <a href="#" class="btn btn-primary">Tilføj til Kurv</a>
                </div>
            </div>
        </div>
    }
</div>

