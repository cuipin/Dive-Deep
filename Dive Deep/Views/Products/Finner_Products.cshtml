@using Dive_Deep.Models;
@using Dive_Deep.Models.ProduktTypes;
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@model IEnumerable<Finner>
@{
    ViewData["title"] = "Finner Produkter";
}

<div class="row row-cols-1 row-cols-md-3 g-4">
    @foreach (var Finner in Model)
    {
        <div class="col">
            <div class="card">
                <a href="default.asp"><img src="~/lib/Images/Finner.jpg" class="card-img-top" alt="..."></a>
                <div class="card-body">
                    <h5 class="card-title">Model: @Finner.Model</h5>
                    <h5 class="card-title">Mærke: @Finner.Mærke</h5>
                    <h5 class="card-title">Størrelse: @Finner.Størrelse</h5>
                    <h5 class="card-title">Pris pr dag i kr: @Finner.PrisPrDag</h5>
                    <p class="card-text"></p>
                    <a href="#" class="btn btn-primary">Tilføj til Kurv</a>
                </div>
            </div>
        </div>
    }
</div>
